# Plantilla pública versionada. Nunca coloques secretos reales en este archivo.
# Cópiala como .env y configura allí valores únicos. No ejecutes `source .env`.

POSTGRES_DB=bot_ofertas
POSTGRES_USER=bot_ofertas
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
BOT_USER_AGENT="BotOfertas/0.1 (+https://github.com/PryRCP-surcv/Bot-Ofertas; public-price-monitor)"

# Fase 1: scheduler y detector (porcentajes, no proporciones)
BOT_SCHEDULER_POLL_SECONDS=300
BOT_DETECTION_HISTORY_LIMIT=90
BOT_DETECTION_MIN_HISTORY_SAMPLES=3
BOT_DEAL_GOOD_PERCENT=20
BOT_DEAL_EXCEPTIONAL_PERCENT=40
BOT_DEAL_PRICE_ERROR_PERCENT=70
BOT_ALERT_COOLDOWN_HOURS=24
BOT_ALERT_SIGNIFICANT_IMPROVEMENT_PERCENT=5

# Reintentos de notificaciones
BOT_NOTIFICATION_LEASE_SECONDS=120
BOT_NOTIFICATION_MAX_ATTEMPTS=5
BOT_NOTIFICATION_RETRY_BASE_SECONDS=300

# Telegram: actívalo solo en .env después de configurar ambos valores.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
