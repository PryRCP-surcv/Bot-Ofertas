# Plantilla pública versionada. Nunca coloques secretos reales en este archivo.
# Cópiala como .env y configura allí valores únicos. No ejecutes `source .env`.

POSTGRES_DB=bot_ofertas
POSTGRES_USER=bot_ofertas
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
BOT_USER_AGENT="BotOfertas/0.1 (+https://github.com/PryRCP-surcv/Bot-Ofertas; public-price-monitor)"

# Scheduler y umbrales de severidad (porcentajes, no proporciones)
BOT_SCHEDULER_POLL_SECONDS=300
BOT_ANALYSIS_LIMIT=1000
BOT_DETECTION_MIN_HISTORY_SAMPLES=3
BOT_DEAL_GOOD_PERCENT=20
BOT_DEAL_EXCEPTIONAL_PERCENT=35
BOT_DEAL_PRICE_ERROR_PERCENT=70
BOT_VERIFIED_LIST_PRICE_ALERT_PERCENT=35
BOT_ALERT_COOLDOWN_HOURS=24
BOT_ALERT_SIGNIFICANT_IMPROVEMENT_PERCENT=5

# Fase 3: evidencia histórica, equivalencias, confianza y confirmación.
# HISTORY_LIMIT es un número máximo de observaciones; HISTORY_DAYS es tiempo.
BOT_DETECTOR_VERSION=phase3-v2
BOT_DETECTION_HISTORY_LIMIT=2500
BOT_DETECTION_HISTORY_DAYS=90
BOT_EQUIVALENT_MAX_AGE_HOURS=24
BOT_EQUIVALENT_LIMIT=20
BOT_DETECTION_MIN_EQUIVALENT_SAMPLES=2
BOT_CONFIRMATION_REQUIRED=true
BOT_CONFIRMATION_MAX_AGE_MINUTES=180
BOT_CONFIRMATION_PRICE_TOLERANCE_PERCENT=3
BOT_CONFIRMATION_CONFIDENCE_BONUS=20
BOT_ALERT_MIN_CONFIDENCE=50
BOT_PRICE_ERROR_MIN_CORROBORATING_SIGNALS=2
BOT_PRICE_ERROR_MIN_CONFIDENCE=50

# Reintentos de notificaciones
BOT_NOTIFICATION_LEASE_SECONDS=120
BOT_NOTIFICATION_MAX_ATTEMPTS=5
BOT_NOTIFICATION_RETRY_BASE_SECONDS=300

# Telegram: actívalo solo en .env después de configurar token y canal Free.
# TELEGRAM_CHAT_ID se conserva como fallback compatible. En instalaciones nuevas
# usa TELEGRAM_FREE_CHAT_ID. VIP es opcional y, durante 6.7A, recibe un espejo
# completo para validar la infraestructura antes de aplicar reglas exclusivas.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_FREE_CHAT_ID=
TELEGRAM_VIP_CHAT_ID=
TELEGRAM_VIP_MIRROR_ENABLED=true
TELEGRAM_OPERATIONS_CHAT_ID=

# API administrativa local (Fase 4A).
# Genera el token con:
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# El marcador CHANGE_ME se rechaza intencionalmente al iniciar la API.
BOT_API_ADMIN_TOKEN=CHANGE_ME_GENERATE_A_RANDOM_URL_SAFE_TOKEN
BOT_API_HOST=127.0.0.1
BOT_API_PORT=8000
BOT_API_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
BOT_API_DOCS_ENABLED=true

# Operación local de Fase 4C.
BOT_DASHBOARD_PORT=3000
BOT_BACKUP_INTERVAL_SECONDS=86400
BOT_BACKUP_RETENTION_DAYS=14
BOT_BACKUP_CHECK_SECONDS=300

# Vigilancia del trabajador. TELEGRAM_ADMIN_CHAT_ID es opcional; si queda vacío
# usa TELEGRAM_CHAT_ID para avisar una caída y posterior recuperación.
BOT_WATCHDOG_POLL_SECONDS=60
BOT_WATCHDOG_GRACE_SECONDS=180
TELEGRAM_ADMIN_CHAT_ID=


